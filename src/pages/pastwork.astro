---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Past Work — Charlie Liao">
  <div class="px-6 lg:px-[160px] py-8 tracking-[0.05em]">
    <h2 class="text-xl lg:text-3xl  font-normal mb-8 "  style="color: var(--color-orange);">Past work</h2>

    <!-- Video -->
    <div class="mb-8 lg:px-4">
        <p class="text-sm lg:text-lg uppercase font-medium tracking-[0.12em] mb-4 " >Video</p>
        <div class="border-t border-white/65 py-4">
          <p class="text-sm lg:text-lg font-medium">Videographer / Street Ball Series, Game Highlights</p>
          <p class="text-sm lg:text-base text-white/65 mt-0.5 mx-2">YouTube Channel — Like Mike Sports</p>
          
          <a href="https://www.youtube.com/@LIKEMIKESports/featured" class="text-sm lg:text-base underline mx-2" style="color: var(--color-orange);">YouTube</a>
          <a href="https://youtube.com/playlist?list=PLHTtWI_0R1nbVeWKhpjms46I0g8yQWEQa&si=s3Ppip7m0JzV611o" class="text-sm lg:text-base underline mx-2" style="color: var(--color-orange);">Street Ball Series</a>
          <a href="https://youtube.com/playlist?list=PLHTtWI_0R1nYWUlOgIBWVoSeMNlqK8eKU&si=7PIvP0_Y3MUZZGMu" class="text-sm lg:text-base underline mx-2" style=" color: var(--color-orange);">Game Highlights</a>
        </div>
        
        <div class="border-t border-white/10 py-4">
          <p class="text-sm lg:text-lg font-medium">Videographer / Video Course Producer</p>
          <p class="text-sm lg:text-base  text-white/65 mt-0.5 mx-2">NTU Language Training & Testing Center</p>
          <a href="https://www.lttc.ntu.edu.tw/" class="mx-2 text-sm lg:text-base underline" style="color: var(--color-orange);">Link</a>
          
        </div>


      <div class="border-t  border-white/10 py-4">
        <p class="text-sm lg:text-lg font-medium">Animation Editor</p>
        <p class="text-sm lg:text-base text-white/65 mt-0.5 mx-2">Taipei East Gate Presbyterian Church</p>
        <a href="https://www.eastgate.org.tw/" class="text-sm lg:text-base underline mx-2" style="color: var(--color-orange);">Link</a>
      </div>
    </div>

    <!-- 3D & Interactive -->
    <div class="mb-10 lg:px-4">
      <p class="text-sm lg:text-lg uppercase font-medium tracking-[0.12em] mb-4 ">Game Design</p>

      <div class="border-t border- border-white/65 py-4">
        <p class="text-sm lg:text-lg font-medium">3D Modeling, Character Animation, Scene Design, Prototype Development</p>
        <p class="text-sm lg:text-base text-white/65 mt-0.5 mx-2">Shokudo Underworld</p>
        <a href="https://store.steampowered.com/app/3050530/_/" class="text-sm lg:text-base underline mx-2" style="color: var(--color-orange);">Steam Link</a>
       
      </div>
    </div>
</div>
</Layout>