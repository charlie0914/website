<script>
  function filter(type) {
    const items = document.querySelectorAll('.gallery-item');
    const buttons = { all: 'btn-all', lms: 'btn-lms', wildlife: 'btn-wildlife', '3d': 'btn-3d' };

    Object.values(buttons).forEach(id => {
      document.getElementById(id).classList.add('opacity-50');
      document.getElementById(id).classList.remove('border-b', 'border-white');
    });

    document.getElementById(buttons[type]).classList.remove('opacity-50');
    document.getElementById(buttons[type]).classList.add('border-b', 'border-white');

    items.forEach(item => {
      item.style.display = (type === 'all' || item.dataset.type === type) ? 'block' : 'none';
    });
  }

  window.filter = filter;
</script>