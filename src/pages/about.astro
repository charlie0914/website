---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About — Charlie Liao">
  <main class="px-6 lg:px-[160px] py-10">
    <div class="flex flex-col md:flex-row gap-10 items-center lg:px-6">

      <img src="/images/pfp/pfp.jpg" alt="Charlie Liao" class="w-full md:w-[320px] shrink-0 aspect-[3/4] object-cover rounded-xl" />

      <div class="flex flex-col gap-4 p-4 text-white/80 text-lg lg:text-xl leading-relaxed">
        <p>hi Im charlie, videographer and editor with experience across sports content, e-learning production, and game development.</p>
        <p>I work from lighting, audio, to final product, and when im off the camera, i make coffee, sending memes to my friends, and touch some grass.</p>
        <p>feel free to send me a line at charlieliao99@gmail.com</p>
      </div>

    </div>
  </main>
</Layout>
