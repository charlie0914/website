---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Charlie Liao — Videographer">
  <div class="flex flex-col items-center justify-center py-32 mx-6">
    
    <!-- Video embed -->
    <div class="w-full max-w-4xl aspect-video rounded-2xl overflow-hidden border border-white/20">
      <iframe
        class="w-full h-full"
        src="https://player.vimeo.com/video/1195556885?badge=0&autoplay=0&muted=0&player_id=0&app_id=58479"
        allow="fullscreen"
        allowfullscreen>
      </iframe>
    </div>

    <!-- Label -->
    <p class="mt-6 tracking-widest text-center text-2xl">Reels 2026</p>

  </div>
  
</Layout>