---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Charlie Liao — Videographer">
  <div class="flex flex-col items-center justify-center py-32 ">
    
    <!-- Video embed -->
    <div class="w-full max-w-4xl aspect-video rounded-2xl overflow-hidden border border-white/20">
      <iframe
        class="w-full h-full"
        src="https://www.youtube.com/embed/dQw4w9WgXcQ?rel=0&showinfo=0&modestbranding=1&?vq=hd1080p"
        allow="fullscreen"
        allowfullscreen>
      </iframe>
    </div>

    <!-- Label -->
    <p class="mt-6 tracking-widest text-center text-2xl">Reels 2026</p>

  </div>
</Layout>